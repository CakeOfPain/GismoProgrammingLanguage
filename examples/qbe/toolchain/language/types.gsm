
void ::= $TYPEDEF($Type(
    void, // id
    "", // prefix
    "", // nativeType
    "", // nativeMemoryType
    VALUE_VOID, // typeName
    $NIL(), // constantType
    $NIL(), // metaData
    0 // memory_size 
), void, TYPE)

i8 ::= $TYPEDEF($Type(
    i8, // id
    "", // prefix
    "w", // nativeType
    "b", // nativeMemoryType
    VALUE_I8, // typeName
    int, // constantType
    $NIL(), // metaData
    1 // memory_size 
), i8, TYPE)

i16 ::= $TYPEDEF($Type(
    i16, // id
    "", // prefix
    "w", // nativeType
    "h", // nativeMemoryType
    VALUE_I16, // typeName
    int, // constantType
    $NIL(), // metaData
    2 // memory_size 
), i16, TYPE)

i32 ::= $TYPEDEF($Type(
    i32, // id
    "", // prefix
    "w", // nativeType
    "w", // nativeMemoryType
    VALUE_I32, // typeName
    int, // constantType
    $NIL(), // metaData
    4 // memory_size 
), i32, TYPE)

i64 ::= $TYPEDEF($Type(
    i64, // id
    "", // prefix
    "l", // nativeType
    "l", // nativeMemoryType
    VALUE_I64, // typeName
    int, // constantType
    $NIL(), // metaData
    8 // memory_size 
), i64, TYPE)

f64 ::= $TYPEDEF($Type(
    f64, // id
    "d_", // prefix
    "d", // nativeType
    "d", // nativeMemoryType
    VALUE_F64, // typeName
    float, // constantType
    $NIL(), // metaData
    8 // memory_size 
), f64, TYPE)

str ::= $TYPEDEF($Type(
    str, // id
    "", // prefix
    "l", // nativeType
    "l", // nativeMemoryType
    VALUE_STR, // typeName
    string, // constantType
    $NIL(), // metaData
    8 // memory_size 
), str, TYPE)

bool ::= $TYPEDEF($Type(
    bool, // id
    "", // prefix
    "w", // nativeType
    "b", // nativeMemoryType
    VALUE_BOOL, // typeName
    $NIL(), // constantType
    $NIL(), // metaData
    1 // memory_size 
), bool, TYPE)

ref(TYPE) ::= {
    refTypeRaw ::= $2
    refType ::= $UNTYPE(refTypeRaw)
    typeId ::= $SYMCAT(ref_, refType.id)

    template ::= $QUOTE($TYPEDEF($Type(
        typeId, // id
        "", // prefix
        "l", // nativeType
        "l", // nativeMemoryType
        VALUE_REF, // typeName
        $NIL(), // constantType
        refTypeRaw, // metaData
        8 // memory_size 
    ), T, TYPE))

    $EVAL($REPLACE(template, T, typeId))
}

// Structs definitons
struct(*) ::= {
    fieldsRaw ::= $FLATTEN($QUOTE($2), ",")
    fields ::= fieldsRaw map $LAMBDA(x, {
        $IF($EQUALS($CAR(x), ":"), {}, { // no
            $RAISE($$, "Invalid operator within argument definition")
        })
        T ::= $EVAL($CAR($CDR($CDR(x))))
        NAME ::= $CAR($CDR(x))

        // CHECK: Ensure NAME is a symbol
        $IF($TYPEOF(NAME, "symbol"), {}, $RAISE($$, $CAT("Expected a symbol, not ", NAME)))

        // CHECK: Ensure T is a valid type immediately
        $IF($TYPEOF(T, "TYPE"), {}, $RAISE($$, $CAT("Expected a valid Type descriptor, not ", T)))

        // Transform into Variable object
        $CONS(NAME, T)
    })

    typeId ::= struct_
    $FOREACH(fields, field, (typeId ::= $SYMCAT($SYMCAT(typeId, $UNTYPE($CDR($QUOTE(field))).id), "_")))
    typeId ::= $SYMCAT(typeId, structend)

    $TYPEDEF($Type(
        typeId, // id
        "", // prefix
        "l", // nativeType
        "l", // nativeMemoryType
        VALUE_STRUCT, // typeName
        $NIL(), // constantType
        fields, // metaData
        8 // memory_size
    ), STRUCTDEF, TYPE)
}

TYPE2TYPENAME ::= $LAMBDA(x, {
    $UNTYPE(x).typeName
})

TYPE2NATIVE ::= $LAMBDA(x, {
    $UNTYPE(x).constantType
})

TYPE2LANGTYPE ::= $LAMBDA(x, {
    $UNTYPE(x).id
})

TYPE2ALIGNMENT ::= $LAMBDA(x, {
    $IF($UNTYPE(x).memory_size < 4, 4, {
        $IF($UNTYPE(x).memory_size < 8, 8, 16)
    })
})

sizeof(TYPE)   ::= $UNTYPE($2).memory_size
sizeof(STRUCTDEF) ::= {
    type ::= $UNTYPE($2)
    sumOfMemory ::= 0
    $FOREACH(type.metaData, x, (sumOfMemory ::= {
        sumOfMemory + $UNTYPE($CDR($QUOTE(x))).memory_size
    }))
    sumOfMemory
}