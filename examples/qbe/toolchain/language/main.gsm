// Keywords
$KEYWORD(ref)
$KEYWORD(deref)
$KEYWORD(stack)
$KEYWORD(if)
$KEYWORD(continue)
$KEYWORD($NEWADDR)
$KEYWORD($NEWCONTINUEID)
$KEYWORD(struct)
$KEYWORD(sizeof)
$KEYWORD(null)
$KEYWORD(macro)
$KEYWORD(import)

$NEWADDR() ::= $CAT("%t", $IOTA())

// Builtin Types
$LOAD("toolchain/language/types.gsm")

// constants
true ::= $TYPEDEF($Value(bool, 1), VALUE_BOOL)
false ::= $TYPEDEF($Value(bool, 0), VALUE_BOOL)

// macro likes
// macro(symbol) ::= $TYPEDEF($QUOTE($2), MACRO_PROTO)
// MACRO_PROTO => (*) ::= $TYPEDEF($CONS($UNTYPE($1), $QUOTE($2)), MACRO)
// MACRO(*) ::= $EVAL($REPLACE($QUOTE($EVAL($REPLACE($CDR($UNTYPE($1)), S, $QUOTE($2)))), S, $CAR($UNTYPE($1))))
macro(*) ::= {
    arguments ::= $FLATTEN($QUOTE($2), ",")
    $TYPEDEF(arguments, MACRO_PROTO)
}
MACRO_PROTO => (*) ::= $TYPEDEF($CONS($UNTYPE($1), $QUOTE($2)), MACRO)
MACRO(*) ::= $DO(
    ($VALS ::= $FLATTEN($QUOTE($2), ",")),
    ($ARGS ::= $CAR($UNTYPE($1))),

    $IF($EQUALS($VECTOR_LEN($VALS), $VECTOR_LEN($ARGS)), {}, {
        $RAISE($$, "Argument count mismatch")
    }),

    ($EXPR ::= $CDR($UNTYPE($1))),

    $FOREACH($ARGS zip $VALS, $X, $DO(
        ($ARG ::= $CAR($QUOTE($X))),
        ($VAL ::= $CDR($QUOTE($X))),
        ($EXPR ::= $EVAL($REPLACE($QUOTE($REPLACE($EXPR, S, $VAL)), S, $ARG)))
    )),

    $EVAL($EXPR)
)

macro() ::= $TYPEDEF(0, SIMPLE_MARCO_PROTO)
SIMPLE_MARCO_PROTO => (*) ::= $TYPEDEF($QUOTE($2), SIMPLE_MACRO)
SIMPLE_MACRO() ::= $EVAL($UNTYPE($1))

// Global Contants
symbol = MACRO ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = SIMPLE_MACRO::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = int ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = string ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = float ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = VALUE_BOOL ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = struct ::= {
    name ::= $QUOTE($1)
    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        "", // prefix
        "l", // nativeType
        "l", // nativeMemoryType
        VALUE_STRUCT, // typeName
        $NIL(), // constantType
        $VECTOR(0), // metaData
        8 // memory_size 
    ), STRUCTDEF, TYPE))
}

symbol = STRUCTDEF ::= {
    name ::= $QUOTE($1)
    parentType ::= $UNTYPE($2)

    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        parentType.prefix, // prefix
        parentType.nativeType, // nativeType
        parentType.nativeMemoryType, // nativeMemoryType
        parentType.typeName, // typeName
        parentType.constantType, // constantType
        parentType.metaData, // metaData
        parentType.memory_size // memory_size 
    ), STRUCTDEF, TYPE))
}

symbol[TYPE] ::= $EVAL($SYMCAT($QUOTE($1), $UNTYPE($2).id))

STRUCTDEF = STRUCTDEF ::= {
    name ::= $UNTYPE($1).id
    parentType ::= $UNTYPE($2)

    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        parentType.prefix, // prefix
        parentType.nativeType, // nativeType
        parentType.nativeMemoryType, // nativeMemoryType
        parentType.typeName, // typeName
        parentType.constantType, // constantType
        parentType.metaData, // metaData
        parentType.memory_size // memory_size 
    ), STRUCTDEF, TYPE))
}

symbol = TYPE ::= {
    name ::= $QUOTE($1)
    parentType ::= $UNTYPE($2)

    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        parentType.prefix, // prefix
        parentType.nativeType, // nativeType
        parentType.nativeMemoryType, // nativeMemoryType
        parentType.typeName, // typeName
        parentType.constantType, // constantType
        parentType.metaData, // metaData
        parentType.memory_size // memory_size 
    ), TYPE))
}

// Imports
IMPORTED_MODULES ::= $VECTOR(0)
import(*) ::= $DO(
    ($IMPORTS ::= $FLATTEN($QUOTE($2), ",")),
    ($IMPORTING ::= $VECTOR(0)),

    {
        IMPORT_PATH.(*) ::= {
            path ::= $UNTYPE($1) 
            folder ::= $QUOTE($2)
            
            new_path ::= $CAT(path, $CAT("/", folder))

            $TYPEDEF(new_path, IMPORT_PATH)
        }

        IMPORT_PATH[*] ::= {
            path ::= $UNTYPE($1)
            arguments ::= $FLATTEN($QUOTE($2), ",")
            $TYPEDEF($CONS(path, arguments), TEMPLATE_IMPORT_PATH)
        }

        TEMPLATE_IMPORT_PATH(*) ::= {
            value ::= $UNTYPE($1)
            arguments ::= $FLATTEN($QUOTE($2), ",")

            obj ::= $struct(path, argNames, argVals)($CAR(value), $CDR(value), arguments)

            $TYPEDEF(obj, ARGUMENT_IMPORT_PATH)
        }

        $FOREACH($IMPORTS, imp, {
            project ::= $TYPEDEF(".", IMPORT_PATH)

            value ::= $EVAL(imp)
            $IF($TYPEOF(value, IMPORT_PATH), {
                path ::= $PATH($UNTYPE(value)  + ".gsm")
                $IF(IMPORTED_MODULES includes path, {}, {
                    IMPORTED_MODULES append path
                    $IMPORTING append value
                })
            }, $IF($TYPEOF(value, ARGUMENT_IMPORT_PATH), {
                importTemplate ::= $UNTYPE(value)
                path ::= $PATH(importTemplate.path + ".gsm") + "@" + (importTemplate.argNames join "|") + "@" + (importTemplate.argVals join "|")

                $IF(IMPORTED_MODULES includes path, {}, {
                    IMPORTED_MODULES append path
                    $IMPORTING append value
                })
            }, {
                $RAISE($$, "Syntax Error within import statement")
            }))
        })
    },

    $FOREACH($IMPORTING, $X,
        $IF($TYPEOF($X, IMPORT_PATH), $DO(
            // CASE: IMPORT_PATH
            $LOAD($UNTYPE($X) + ".gsm")
        ), $IF($TYPEOF($X, ARGUMENT_IMPORT_PATH), $DO(
            // CASE: ARGUMENT_IMPORT_PATH
            ($IMPORTPATH ::= $UNTYPE($X)),
            $FOREACH($IMPORTPATH.argNames zip $IMPORTPATH.argVals, arg, $DO(
                (argName ::= $CAR($QUOTE(arg))),
                (argVal  ::= $EVAL($CDR($QUOTE(arg)))),
                $EVAL($REPLACE($QUOTE(V ::= argVal), V, argName))
            )),
            $LOAD($IMPORTPATH.path + ".gsm")
        ), $DO(
            // CASE: OTHER
            $RAISE($$, "Syntax Error within import statement")
        )))
    )
)

$LOAD("toolchain/language/functiondef.gsm")