// Keywords
$KEYWORD(ref)
$KEYWORD(deref)
$KEYWORD(stack)
$KEYWORD(if)
$KEYWORD(continue)
$KEYWORD($NEWADDR)
$KEYWORD($NEWCONTINUEID)
$KEYWORD(struct)
$KEYWORD(sizeof)
$KEYWORD(null)

$NEWADDR() ::= $CAT("%t", $IOTA())

// Builtin Types
$LOAD("toolchain/language/types.gsm")

// constants
true ::= $TYPEDEF($Value(bool, 1), VALUE_BOOL)
false ::= $TYPEDEF($Value(bool, 0), VALUE_BOOL)

// Global Contants
symbol = int ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = string ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = float ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = VALUE_BOOL ::= {
    $EXPORT($QUOTE($1), $2)
}

symbol = struct ::= {
    name ::= $QUOTE($1)
    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        "", // prefix
        "l", // nativeType
        "l", // nativeMemoryType
        VALUE_STRUCT, // typeName
        $NIL(), // constantType
        $VECTOR(0), // metaData
        8 // memory_size 
    ), STRUCTDEF, TYPE))
}

symbol = STRUCTDEF ::= {
    name ::= $QUOTE($1)
    parentType ::= $UNTYPE($2)

    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        parentType.prefix, // prefix
        parentType.nativeType, // nativeType
        parentType.nativeMemoryType, // nativeMemoryType
        parentType.typeName, // typeName
        parentType.constantType, // constantType
        parentType.metaData, // metaData
        parentType.memory_size // memory_size 
    ), STRUCTDEF, TYPE))
}

symbol<TYPE> ::= $SYMCAT($QUOTE($1), $UNTYPE($2).id)

STRUCTDEF = STRUCTDEF ::= {
    name ::= $UNTYPE($1).id
    parentType ::= $UNTYPE($2)

    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        parentType.prefix, // prefix
        parentType.nativeType, // nativeType
        parentType.nativeMemoryType, // nativeMemoryType
        parentType.typeName, // typeName
        parentType.constantType, // constantType
        parentType.metaData, // metaData
        parentType.memory_size // memory_size 
    ), STRUCTDEF, TYPE))
}

symbol = TYPE ::= {
    name ::= $QUOTE($1)
    parentType ::= $UNTYPE($2)

    $EXPORT(name, $TYPEDEF($Type(
        name, // id
        parentType.prefix, // prefix
        parentType.nativeType, // nativeType
        parentType.nativeMemoryType, // nativeMemoryType
        parentType.typeName, // typeName
        parentType.constantType, // constantType
        parentType.metaData, // metaData
        parentType.memory_size // memory_size 
    ), TYPE))
}

$LOAD("toolchain/language/functiondef.gsm")