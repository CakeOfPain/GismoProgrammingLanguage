
FunctionProto = (*) ::= ($UNTYPE($1).name) = $2

// int:
symbol = int ::= {
    name ::= $QUOTE($1)
    $WRITE("\t%")
    $WRITE(name)
    $WRITE(" =l copy ")
    $WRITE($2)
    $WRITE("\n")
    $EXPORT(name, $TYPEDEF($Value(i64, $CAT("%", name)), VALUE_I64))
}

symbol = VALUE_I8 ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_I8))
}

symbol = VALUE_I16 ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_I16))
}

symbol = VALUE_I32 ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_I32))
}

symbol = VALUE_I64 ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_I64))
}

symbol = VALUE_BOOL ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_BOOL))
}

// float:
symbol = float ::= {
    name ::= $QUOTE($1)
    $WRITE("\t%")
    $WRITE(name)
    $WRITE(" =d copy d_")
    $WRITE($2)
    $WRITE("\n")
    $EXPORT(name, $TYPEDEF($Value(f64, $CAT("%", name)), VALUE_F64))
}

symbol = VALUE_F64 ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_F64))
}

// string:
symbol = string ::= {
    name ::= $QUOTE($1)
    index ::= $DECLARE_STRING($2)
    addr ::= $CAT("$str", index)

    $WRITE("\t%")
    $WRITE(name)
    $WRITE(" =l copy ")
    $WRITE(addr)
    $WRITE("\n")
    
    $EXPORT(name, $TYPEDEF($Value(str, $CAT("%", name)), VALUE_STR))
}

symbol = VALUE_STR ::= {
    name ::= $QUOTE($1)
    value ::= $UNTYPE($2)
    $EXPORT(name, $TYPEDEF(value, VALUE_STR))
}

symbol = VALUE_REF ::= {
    name ::= $QUOTE($1)
    $EXPORT(name, $2)
}

// Reference

VALUE_REF $STORE2MEM (*) ::= {
    ref       ::= $UNTYPE($1)
    value     ::= $UNTYPE($2)
    type      ::= $UNTYPE(value.type)
    metatype  ::= $UNTYPE($UNTYPE(ref.type).metaData)
    // TODO: Saidly this is not going to give good errors
    $IF($EQUALS(type.id, metatype.id), {
        $WRITE("\t")
        $WRITE("store")
        $WRITE(metatype.nativeMemoryType)
        $WRITE(" ")
        $WRITE(value.addr)
        $WRITE(", ")
        $WRITE(ref.addr)
        $WRITE("\n")

        $NIL()
    }, { // ELSE:
        "Cannot store value into reference, type missmatch"
    })
}

string $ASSERT_STORE2MEM (*) ::= $RAISE($2, $1)
Nil $ASSERT_STORE2MEM (*) ::= $NIL()

VALUE_REF <- int ::= ($1 $STORE2MEM i64($2)) $ASSERT_STORE2MEM $$
VALUE_REF <- float ::= ($1 $STORE2MEM f64($2)) $ASSERT_STORE2MEM $$
VALUE_REF <- string ::= ($1 $STORE2MEM str($2)) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_I8  ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_I16 ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_I32 ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_I64 ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_F64 ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_REF ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_STR ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$
VALUE_REF <- VALUE_BOOL ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$

VALUE_REF <- null ::= {
    subType ::= $UNTYPE($UNTYPE($1).type).metaData
    nullptr ::= $UNTYPE(i64(0))
    
    $IF($EQUALS($UNTYPE(subType).typeName, VALUE_REF), {
        $1 <- $TYPEDEF($Value(ref(subType), nullptr.addr), VALUE_REF)
    }, {
        $IF($EQUALS($UNTYPE(subType).typeName, VALUE_STRUCT), {
            $1 <- $TYPEDEF($Value(subType, nullptr.addr), VALUE_STRUCT)
        }, {
            $RAISE($$, "Cannot assign null to an non reference type")
        })
    })
}

// Structs
symbol = VALUE_STRUCT ::= {
    name ::= $QUOTE($1)
    $EXPORT(name, $2)
}

VALUE_REF <- VALUE_STRUCT ::= ($1 $STORE2MEM $2) $ASSERT_STORE2MEM $$