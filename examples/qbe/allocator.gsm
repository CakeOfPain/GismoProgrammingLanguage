
Allocator[T] = struct(
    memory: ref(T),
    ptr: i64,
    capacity: i64
)

make[Allocator[T]](
    capacity: i64,
    memory: ref(T),
    self: Allocator[T]
): Allocator[T] {
    allocator.memory <- memory
    allocator.ptr <- 0
    allocator.capacity <- capacity
    allocator
}

allocate[Allocator[T]]