
$LOAD("./examples/runtime.gsm")

generateRange(a: ref(i8), i: i32, n: i32): ref(i8) {
    if(i >= n) return a

    a(i) <- i8(i)

    continue(a, i+1, n)
}

goPrintNumbers(numbers: ref(i8), n: i32, i: i32): void {
    if (i < n) then {
        printI32(i32(deref(numbers(i))))
        printStr(" ")
        continue(numbers, n, i+1)
    }
}

printNumbers(numbers: ref(i8), n: i32): void {
    goPrintNumbers(numbers, n, 0)
}

int .. int ::= generateRange(stack(i8 * ($2 - $1)), $1, $2)
int .. VALUE_I32 ::= generateRange(stack(i8 * ($2 - $1)), $1, $2)

Person = type(i32)

main(): i32 {
    n = immediateReadI32()
    numbers = 0..n
    printNumbers(numbers, n)
    0
}