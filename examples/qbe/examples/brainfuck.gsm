$LOAD("./examples/runtime.gsm")

// > | ptr++;
// < | ptr--;
// + | cell[ptr]++;
// - | cell[ptr]--;
// . | putchar (cell[ptr]);
// , | cell[ptr] = getchar();
// [ | while (cell[ptr]) {
// ] | }

indexOfOpeningBracket(programBuffer: ref(i8), pc: i32, numberOfBrackets: i32): i32 {
    currentInstruction = deref(programBuffer(pc))
    if (numberOfBrackets <= 0) return pc+1
    if (currentInstruction == 91) then {
        // [
        continue(programBuffer, pc-1, numberOfBrackets-1)
    }
    if (currentInstruction == 93) then {
        // ]
        continue(programBuffer, pc-1, numberOfBrackets+1)
    }

    continue(programBuffer, pc-1, numberOfBrackets)
}

indexOfClosingBracket(programBuffer: ref(i8), pc: i32, numberOfBrackets: i32): i32 {
    currentInstruction = deref(programBuffer(pc))
    if (numberOfBrackets <= 0) return pc-1
    if (currentInstruction == 91) then {
        // [
        continue(programBuffer, pc+1, numberOfBrackets+1)
    }
    if (currentInstruction == 93) then {
        // ]
        continue(programBuffer, pc+1, numberOfBrackets-1)
    }

    continue(programBuffer, pc+1, numberOfBrackets)
}

assertBracket(currentValue: i32, programBuffer: ref(i8), pc: i32): i32 {
    if (currentValue == 0) return indexOfClosingBracket(programBuffer, pc+1, 1) + 1
    pc+1
}

